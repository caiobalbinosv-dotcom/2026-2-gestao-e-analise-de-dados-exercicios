    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# TREINAMENTO\n",
        "# ============================================================\n",
        "\n",
        "def treinar_modelo(\n",
        "    model,\n",
        "    train_loader,\n",
        "    criterion,\n",
        "    optimizer,\n",
        "    device,\n",
        "    epochs=EPOCHS\n",
        "):\n",
        "\n",
        "    historico_loss = []\n",
        "    historico_accuracy = []\n",
        "\n",
        "    print()\n",
        "    print(\"=\" * 60)\n",
        "    print(\"TREINAMENTO\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Modo de treinamento\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        model.train()\n",
        "\n",
        "        running_loss = 0.0\n",
        "\n",
        "        correct = 0\n",
        "        total = 0\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Percorre os batches\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        for images, labels in train_loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            labels = labels.to(device)\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # 1. Zerar gradientes anteriores\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # 2. Feed Forward\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            outputs = model(images)\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # 3. Calcular o erro\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            loss = criterion(\n",
        "                outputs,\n",
        "                labels\n",
        "            )\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # 4. Backpropagation\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            loss.backward()\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # 5. Gradiente Descendente\n",
        "            #\n",
        "            # Atualiza os pesos\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            optimizer.step()\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # Estatísticas\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            running_loss += (\n",
        "                loss.item()\n",
        "            )\n",
        "\n",
        "            _, predicted = torch.max(\n",
        "                outputs,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            total += labels.size(0)\n",
        "\n",
        "            correct += (\n",
        "                predicted == labels\n",
        "            ).sum().item()\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Métricas da época\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        epoch_loss = (\n",
        "            running_loss\n",
        "            /\n",
        "            len(train_loader)\n",
        "        )\n",
        "\n",
        "        epoch_accuracy = (\n",
        "            100\n",
        "            *\n",
        "            correct\n",
        "            /\n",
        "            total\n",
        "        )\n",
        "\n",
        "        historico_loss.append(\n",
        "            epoch_loss\n",
        "        )\n",
        "\n",
        "        historico_accuracy.append(\n",
        "            epoch_accuracy\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Época \"\n",
        "            f\"{epoch + 1:02d}/\"\n",
        "            f\"{epochs:02d}\"\n",
        "            f\" | \"\n",
        "            f\"Loss: \"\n",
        "            f\"{epoch_loss:.4f}\"\n",
        "            f\" | \"\n",
        "            f\"Acurácia: \"\n",
        "            f\"{epoch_accuracy:.2f}%\"\n",
        "        )\n",
        "\n",
        "    return (\n",
        "        historico_loss,\n",
        "        historico_accuracy\n",
        "    )\n"
      ],
