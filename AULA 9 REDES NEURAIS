        "# ============================================================\n",
        "# MOSTRAR PREVISÕES\n",
        "# ============================================================\n",
        "\n",
        "def mostrar_previsoes(\n",
        "    model,\n",
        "    test_loader,\n",
        "    device,\n",
        "    quantidade=12\n",
        "):\n",
        "\n",
        "    images, labels = next(\n",
        "        iter(test_loader)\n",
        "    )\n",
        "\n",
        "    images_device = images.to(\n",
        "        device\n",
        "    )\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = model(\n",
        "            images_device\n",
        "        )\n",
        "\n",
        "        _, predicted = torch.max(\n",
        "            outputs,\n",
        "            1\n",
        "        )\n",
        "\n",
        "    plt.figure(\n",
        "        figsize=(12, 8)\n",
        "    )\n",
        "\n",
        "    for i in range(quantidade):\n",
        "\n",
        "        plt.subplot(\n",
        "            3,\n",
        "            4,\n",
        "            i + 1\n",
        "        )\n",
        "\n",
        "        image = images[i].permute(\n",
        "            1,\n",
        "            2,\n",
        "            0\n",
        "        )\n",
        "\n",
        "        plt.imshow(image)\n",
        "\n",
        "        real = CLASSES[\n",
        "            labels[i].item()\n",
        "        ]\n",
        "\n",
        "        previsto = CLASSES[\n",
        "            predicted[i].item()\n",
        "        ]\n",
        "\n",
        "        plt.title(\n",
        "            f\"Real: {real}\\n\"\n",
        "            f\"Previsto: {previsto}\"\n",
        "        )\n",
        "\n",
        "        plt.axis(\"off\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# PROBABILIDADES DE UMA IMAGEM\n",
        "# ============================================================\n",
        "\n",
        "def mostrar_probabilidades(\n",
        "    model,\n",
        "    test_loader,\n",
        "    device,\n",
        "    indice=0\n",
        "):\n",
        "\n",
        "    images, labels = next(\n",
        "        iter(test_loader)\n",
        "    )\n",
        "\n",
        "    image = images[\n",
        "        indice\n",
        "    ].unsqueeze(0)\n",
        "\n",
        "    image = image.to(\n",
        "        device\n",
        "    )\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        output = model(\n",
        "            image\n",
        "        )\n",
        "\n",
        "        probabilities = (\n",
        "            torch.softmax(\n",
        "                output,\n",
        "                dim=1\n",
        "            )\n",
        "        )\n",
        "\n",
        "    probabilities = (\n",
        "        probabilities[0]\n",
        "        .cpu()\n",
        "    )\n",
        "\n",
        "    predicted_class = torch.argmax(\n",
        "        probabilities\n",
        "    ).item()\n",
        "\n",
        "    real_class = labels[\n",
        "        indice\n",
        "    ].item()\n",
        "\n",
        "    print()\n",
        "    print(\"=\" * 60)\n",
        "    print(\"PROBABILIDADES\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    print(\n",
        "        f\"Classe real: \"\n",
        "        f\"{CLASSES[real_class]}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Classe prevista: \"\n",
        "        f\"{CLASSES[predicted_class]}\"\n",
        "    )\n",
        "\n",
        "    print()\n",
        "\n",
        "    for classe, prob in zip(\n",
        "        CLASSES,\n",
        "        probabilities\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            f\"{classe:10s}: \"\n",
        "            f\"{prob.item() * 100:6.2f}%\"\n",
        "        )\n"
