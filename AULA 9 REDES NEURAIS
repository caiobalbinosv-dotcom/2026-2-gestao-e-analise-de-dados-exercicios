        "\n",
        "def plotar_accuracy(\n",
        "    historico_accuracy\n",
        "):\n",
        "\n",
        "    epochs = range(\n",
        "        1,\n",
        "        len(historico_accuracy) + 1\n",
        "    )\n",
        "\n",
        "    plt.figure(\n",
        "        figsize=(8, 5)\n",
        "    )\n",
        "\n",
        "    plt.plot(\n",
        "        epochs,\n",
        "        historico_accuracy,\n",
        "        marker=\"o\"\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\n",
        "        \"Época\"\n",
