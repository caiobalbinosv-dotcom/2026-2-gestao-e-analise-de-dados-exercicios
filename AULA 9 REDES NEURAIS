        "# ============================================================\n",
        "# AVALIAÇÃO\n",
        "# ============================================================\n",
        "\n",
        "def avaliar_modelo(\n",
        "    model,\n",
        "    test_loader,\n",
        "    device\n",
        "):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    correct = 0\n",
        "    total = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, labels in test_loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            labels = labels.to(device)\n",
        "\n",
        "            # Feed Forward\n",
        "            outputs = model(images)\n",
        "\n",
        "            _, predicted = torch.max(\n",
        "                outputs,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            total += labels.size(0)\n",
        "\n",
        "            correct += (\n",
        "                predicted == labels\n",
        "            ).sum().item()\n",
        "\n",
        "    accuracy = (\n",
        "        100\n",
        "        *\n",
        "        correct\n",
        "        /\n",
        "        total\n",
        "    )\n",
        "\n",
        "    print()\n",
        "    print(\"=\" * 60)\n",
        "    print(\"TESTE\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    print(\n",
        "        f\"Acurácia no conjunto \"\n",
        "        f\"de teste: \"\n",
        "        f\"{accuracy:.2f}%\"\n",
        "    )\n",
        "\n",
        "    return accuracy\n"
